  "info": {
    "_postman_id": "42749773-838b-41f3-9c63-9743cda56f13",
    "name": "HashiCorp Consul Connect CA API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "HTTP API for the Consul Connect service mesh subsystem of HashiCorp Consul. Connect APIs cover intentions (service-to-service traffic authorization) and certificate authority (CA) management for the built-in mesh CA. ACL tokens are typically passed via the X-Consul-Token header.\n\nContact Support:\n Name: HashiCorp Consul",
      "type": "text/plain"
    }
